{
  "rewrites": [
    {
      "source": "/((?!_vercel/insights/|assets/|images/|theme-init.js|favicon.ico).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ]
}
